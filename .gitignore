# ==================================================
# HeyGem-Enhanced Git Ignore Rules
# ==================================================

# 1. Runtime process states & PIDs
*.pid
*.lock
*.paused
*.tmp

# 2. Logs & execution traces
logs/
*.log
*.out.log
*.err.log

# 3. Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# 4. Virtual environments
venv/
.venv/
env/
ENV/

# 5. Local private configurations & PII
*.local.json
.env
.env.*
!.env.example

# 6. Large binaries & installers (use scripts/download-full-client.ps1 instead)
*.exe
*.msi
*.dll
*.iso
*.tar.gz
*.tgz
*.zip
*.7z

# 7. Media and dataset cache (videos, intermediate audio)
*.mp4
*.wav
*.avi
*.mkv
*.mov

# 8. Local SQLite databases
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# 9. IDE & OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
