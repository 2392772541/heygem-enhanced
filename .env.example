# ==============================================================================
# HeyGem-Enhanced 跨机器环境配置文件模板 (.env.example)
# ==============================================================================
# 使用说明：
# 1. 绝大多数情况下，系统具备完全自动的智能路径嗅探，无需配置即可开箱即用。
# 2. 若您在新电脑上盘符不同（如无 D: 盘只有 C:/F: 盘）或希望自定义输出归档路径，
#    可复制本文件为 .env 并修改相应变量，系统将优先读取环境变量。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker 数据卷根目录 (Docker Compose 映射使用)
# ------------------------------------------------------------------------------
# 默认映射到 d:/duix_avatar_data，请使用正斜杠 (/) 或适合 Docker 的路径
DUIX_DATA_DIR=d:/duix_avatar_data

# ------------------------------------------------------------------------------
# 2. 核心调度与业务数据库
# ------------------------------------------------------------------------------
# HeyGem / Duix.Avatar 客户端的 SQLite 业务数据库路径
# 默认自动嗅探: %APPDATA%\Duix.Avatar\biz.db
# HEYGEM_DB_OVERRIDE=C:\Users\YourUsername\AppData\Roaming\Duix.Avatar\biz.db

# ------------------------------------------------------------------------------
# 3. 渲染工作目录与成品交付目录 (存储与交付解耦)
# ------------------------------------------------------------------------------
# Docker 容器生成音视频分片及临时文件的暂存目录
# 默认自动嗅探: D:\duix_avatar_data\face2face\temp -> C:\duix_avatar_data\face2face\temp
# HEYGEM_OUTPUT_ROOT=D:\duix_avatar_data\face2face\temp

# 成片导出交付归档目录 (渲染完成后自动校验 ffprobe 与哈希并归档到此处)
# 默认自动嗅探: E:\数字人视频文件 -> D:\数字人视频文件 -> 桌面\数字人视频文件
# HEYGEM_DELIVERY_ROOT=E:\数字人视频文件

# 模特底模与声音样本的原始音频目录
# 默认自动嗅探: D:\duix_avatar_data\voice\data -> C:\duix_avatar_data\voice\data
# HEYGEM_VOICE_ROOT=D:\duix_avatar_data\voice\data

# ------------------------------------------------------------------------------
# 4. 双模语音 (TTS) 与外部模型集成
# ------------------------------------------------------------------------------
# 本地 IndexTTS2 项目代码根目录 (若不需要 IndexTTS2，系统会自动降级回原生 Fish-Speech)
# 默认自动嗅探: D:\HeyGem\tts-story-f5 -> E:\HeyGem\tts-story-f5 -> C:\HeyGem\tts-story-f5
# HEYGEM_INDEXTTS2_ROOT=D:\HeyGem\tts-story-f5

# 运行 IndexTTS2 适配器服务的 Python 解释器路径 (通常为 IndexTTS2 的虚拟环境)
# 默认: %HEYGEM_INDEXTTS2_ROOT%\venv\Scripts\python.exe
# HEYGEM_ADAPTER_PYTHON=D:\HeyGem\tts-story-f5\venv\Scripts\python.exe

# 当前 TTS 模式标记文件路径
# 默认: 项目根目录\tts-mode.txt (内容为 index-tts2 或 fish-speech)
# HEYGEM_MODE_FILE=tts-mode.txt

# ------------------------------------------------------------------------------
# 5. 桌面客户端主程序
# ------------------------------------------------------------------------------
# Duix.Avatar 客户端安装路径
# 默认自动嗅探: C:\Program Files\Duix.Avatar\Duix.Avatar.exe
# HEYGEM_CLIENT_EXE=C:\Program Files\Duix.Avatar\Duix.Avatar.exe

# ------------------------------------------------------------------------------
# 6. Docker Compose 编排模式选择
# ------------------------------------------------------------------------------
# 可选值:
#   deploy/docker-compose.yml       (通用标准配置，适合 RTX 30/40 等常规 GPU)
#   deploy/docker-compose-5090.yml  (RTX 50 系列专供，如 RTX 5090/5080 新显卡)
#   deploy/docker-compose-lite.yml  (轻量化单视频容器，TTS 由外部或本地 IndexTTS2 承担)
#   deploy/docker-compose-linux.yml (Linux 原生环境部署)
# COMPOSE_FILE=deploy/docker-compose.yml
